{
  "name": "@catreeo123/vulnscan",
  "version": "0.2.22",
  "description": "Scan Node.js dependencies for vulnerabilities missing from npm audit",
  "type": "module",
  "bin": {
    "vulnscan": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catreeo123/vulnscan.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\""
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
