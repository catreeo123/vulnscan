{
  "name": "@catreeo123/vulnscan",
  "version": "0.0.1",
  "description": "Scan Node.js dependencies for vulnerabilities missing from npm audit",
  "type": "module",
  "bin": {
    "vulnscan": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\""
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
